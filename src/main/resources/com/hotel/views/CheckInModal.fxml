<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefWidth="320.0" spacing="12.0"
      xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hotel.controller.CheckInController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="lblTituloQuarto" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Check-in" />

    <TextField fx:id="txtNomeHospede" promptText="Nome do Hóspede" />
    <TextField fx:id="txtCpfHospede" promptText="CPF do Hóspede" />
    <TextField fx:id="txtDias" promptText="Quantidade de Diárias" />

    <Button maxWidth="Infinity" onAction="#confirmarCheckIn"
            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="Confirmar Check-in" />
</VBox>